@font-face { font-display: block; font-family: codicon; src: url("../base/browser/ui/codicons/codicon/codicon.ttf") format("truetype"); }

.codicon[class*="codicon-"] { display: inline-block; font: 16px / 1 codicon; text-align: center; text-decoration: none; text-rendering: auto; text-transform: none; -webkit-font-smoothing: antialiased; user-select: none; }

.codicon-wrench-subaction { opacity: 0.5; }

